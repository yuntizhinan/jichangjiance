---
import { ArrowUp, Mail, Rss } from '@lucide/astro';
import { site } from '../lib/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <div class="footer-brand-row"><span class="brand-mark">J</span><strong>{site.name}</strong></div>
      <p>持续整理机场代理、机场推荐、AI 资讯、工具教程、优惠信息与服务风险观察。</p>
    </div>
    <div>
      <h2>核心栏目</h2>
      <a href="/brands/">机场评测库</a><a href="/airport-comparison/">机场排行榜</a><a href="/airport-recommendations/">机场推荐</a><a href="/deals/">机场优惠码</a><a href="/alerts/">跑路预警</a>
    </div>
    <div>
      <h2>浏览内容</h2>
      <a href="/articles/">全部文章</a><a href="/categories/">文章分类</a><a href="/faq/">常见问题</a>
    </div>
    <div>
      <h2>订阅与联系</h2>
      <a href="/feed.xml"><Rss size={14} /> RSS 订阅</a>
      <a href={`mailto:${site.email}`}><Mail size={14} /> {site.email}</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <div><a href="/about/">关于本站</a><a href="/privacy/">隐私说明</a><a href="/sitemap-index.xml">站点地图</a></div>
  </div>
  <button class="back-to-top" type="button" aria-label="返回顶部" data-back-to-top><ArrowUp size={18} /></button>
</footer>

<script>
  const button = document.querySelector<HTMLElement>('[data-back-to-top]');
  const updateButton = () => button?.classList.toggle('is-visible', window.scrollY > 500);
  updateButton();
  window.addEventListener('scroll', updateButton, { passive: true });
  button?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
