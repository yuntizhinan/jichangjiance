---
import { ArrowRight, CalendarDays, Clock3, UserRound } from '@lucide/astro';
import { categoryByName, formatDate } from '../lib/site';
interface Props { article: any; compact?: boolean }
const { article, compact = false } = Astro.props;
const { data } = article;
const category = categoryByName[data.category];
---

<article class:list={['post-card', `tone-${data.coverTone}`, { compact }]}> 
  <a class="post-thumbnail" href={`/articles/${article.id}/`} aria-label={`阅读：${data.title}`}>
    {data.image ? (
      <img src={data.image} alt={data.imageAlt ?? data.title} width="640" height="360" loading="lazy" decoding="async" />
    ) : (
      <div class="post-thumbnail-fallback" aria-hidden="true">
        <span>{data.category}</span>
        <strong>{data.title.slice(0, 1)}</strong>
      </div>
    )}
  </a>
  <div class="post-card-content">
    <div class="post-card-header">
      <a class="post-category" href={`/categories/${category?.slug ?? 'beginner'}/`}>{data.category}</a>
      <h3><a href={`/articles/${article.id}/`}>{data.title}</a></h3>
    </div>
    <p>{data.description}</p>
    <div class="post-card-meta">
      <span><CalendarDays size={14} /> {formatDate(data.updatedAt)}</span>
      <span><Clock3 size={14} /> {data.readingTime}</span>
      <span><UserRound size={14} /> {data.author}</span>
      <a class="post-read-more" href={`/articles/${article.id}/`}>阅读全文 <ArrowRight size={14} /></a>
    </div>
  </div>
</article>
