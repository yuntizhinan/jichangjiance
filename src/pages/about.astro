---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../lib/site';
import { ShieldCheck, Target, HeartHandshake, FileText } from '@lucide/astro';
---

<BaseLayout
  title="关于本站"
  description="了解机场指南的创办初衷、编辑部立场、内容评估标准与免责声明。"
>
  <div class="shell page-container">
    <Breadcrumbs items={[{ label: '关于本站' }]} />

    <div class="page-hero">
      <h1>关于{site.name}</h1>
      <p>把复杂的网络代理与线路知识，讲成清晰、透明、可执行的判断与选择。</p>
    </div>

    <div class="about-content">
      <section class="about-card">
        <div class="card-icon"><Target size={28} /></div>
        <h2>我们的立场与使命</h2>
        <p>
          在中文互联网中，关于网络代理（机场、梯子、翻墙工具）的资讯极为零碎，甚至充斥着大量缺乏依据的营销推广。
          <strong>{site.name}</strong> 的使命是为用户建立一套客观、专业且易于理解的知识体系，帮助你从“完全不懂”到“理性选购与安全配置”。
        </p>
      </section>

      <section class="about-card">
        <div class="card-icon"><ShieldCheck size={28} /></div>
        <h2>独立编辑原则</h2>
        <ul>
          <li><strong>拒绝无脑跟风推荐</strong>：任何评测与评级均基于实际晚高峰丢包、SLA 表现与线路架构分析。</li>
          <li><strong>坚持透明度</strong>：明确区分公网直连、BGP 中转与 IEPL 专线的成本与风险差异。</li>
          <li><strong>关注用户安全</strong>：普及 HTTPS 加密、DNS 泄漏防护与隐私隔离，防止用户资产与隐私受损。</li>
        </ul>
      </section>

      <section class="about-card">
        <div class="card-icon"><HeartHandshake size={28} /></div>
        <h2>联系与建议</h2>
        <p>
          如果你在阅读指南时发现任何信息更新滞后，或者有优秀的工具/规则想要推荐给社区，欢迎发送邮件与编辑部交流：
        </p>
        <p class="contact-email">
          📧 <a href="mailto:psytong@outlook.com">psytong@outlook.com</a>
        </p>
      </section>

      <section class="about-card disclaimer">
        <div class="card-icon"><FileText size={28} /></div>
        <h2>免责与合规声明</h2>
        <p>
          本站点发布的所有文章、教程与技术科普仅供网络技术学习、跨国科研交流及产品选择参考。
          请广大用户在体验网络服务时，严格遵守所在地法律法规，切勿利用网络技术从事非法活动。
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2rem;
  }

  .about-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .about-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .card-icon {
    color: var(--tone-lime);
    margin-bottom: 1rem;
  }

  .about-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .about-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .about-card ul {
    padding-left: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .about-card li strong {
    color: var(--text-primary);
  }

  .contact-email {
    font-weight: 600;
    font-size: 1.05rem !important;
  }

  .contact-email a {
    color: var(--tone-lime);
  }

  .disclaimer {
    border-color: rgba(255, 112, 67, 0.3);
    background: rgba(255, 112, 67, 0.03);
  }

  .disclaimer .card-icon {
    color: var(--tone-coral);
  }
</style>
