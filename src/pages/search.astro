---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import { getCollection } from 'astro:content';
import { Search as SearchIcon, X, Tag } from '@lucide/astro';
import { brands, getBrandIntentKeywords } from '../data/brands';
import { highIntentKeywords } from '../data/keywordClusters';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const searchableArticles = articles.map((a) => ({
  type: 'article',
  id: a.id,
  url: `/articles/${a.id}/`,
  title: a.data.title,
  description: a.data.description,
  category: a.data.category,
  tags: a.data.tags,
  coverTone: a.data.coverTone,
  readingTime: a.data.readingTime,
  author: a.data.author,
  updatedAt: a.data.updatedAt.toISOString(),
  formattedDate: new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(a.data.updatedAt)
}));

const searchableBrands = brands.map((brand) => ({
  type: 'brand',
  id: brand.slug,
  url: `/brands/${brand.slug}/`,
  title: `${brand.name}怎么样？2026 ${brand.name}机场评测`,
  description: brand.description,
    category: '机场独立评测',
  tags: [...getBrandIntentKeywords(brand), ...brand.protocols, ...brand.useCases],
  cover: brand.cover,
  readingTime: brand.recommendation,
  author: '机场监测编辑部',
  formattedDate: '2026年10月6日'
}));

const searchableItems = [...searchableBrands, ...searchableArticles];

const popularTags = Array.from(new Set([
  ...highIntentKeywords,
  ...articles.flatMap((a) => a.data.tags),
  ...brands.flatMap((brand) => brand.keywords.slice(0, 3))
])).slice(0, 12);
---

<BaseLayout
  title="站内搜索"
  description="搜索机场排行榜、独立评测、优惠码、晚高峰、协议分析、客户端教程与规则分流内容。"
  robots="noindex, follow, max-image-preview:large"
>
  <div class="shell page-container">
    <Breadcrumbs items={[{ label: '站内搜索' }]} />

    <div class="page-hero">
      <h1>站内搜索</h1>
        <p>搜索机场名称、优惠码、月付价格、晚高峰、协议或客户端教程。</p>
    </div>

    {/* Search Box Component */}
    <div class="search-section">
      <div class="search-input-container">
        <SearchIcon size={20} class="search-icon-inside" />
        <input
          type="search"
          id="search-input"
          class="search-field"
          placeholder="输入关键词搜索（如：机场优惠码、月付、晚高峰、Clash）..."
          autocomplete="off"
        />
        <button type="button" id="clear-search-btn" class="clear-btn" aria-label="清空搜索">
          <X size={18} />
        </button>
      </div>

      {popularTags.length > 0 && (
        <div class="search-tags-row">
          <span class="search-tag-label"><Tag size={14} /> 快捷热搜：</span>
          <div class="tags-wrapper">
            {popularTags.map((tag) => (
              <button type="button" class="tag-pill-btn" data-tag={tag}>#{tag}</button>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="search-status" id="search-status">
      共找到 <span id="results-count">{searchableItems.length}</span> 项内容
    </div>

    {/* Results Container */}
    <div class="articles-grid" id="search-results-grid">
      {/* SSR fallback initial list */}
      {brands.map((brand) => <BrandCard brand={brand} />)}
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>

    {/* No Results Placeholder */}
    <div id="no-results" class="no-results-box" style="display: none;">
      <h3>未找到相关文章</h3>
        <p>建议尝试机场名称、优惠码、月付机场、晚高峰、Clash 或 IEPL。</p>
    </div>
  </div>
</BaseLayout>

{/* Embed JSON data for client-side instant search */}
<script is:inline define:vars={{ searchableItems }}>
  window.__SEARCH_DATA__ = searchableItems;
</script>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-search-btn');
  const countEl = document.getElementById('results-count');
  const grid = document.getElementById('search-results-grid');
  const noResults = document.getElementById('no-results');
  const tagBtns = document.querySelectorAll('.tag-pill-btn');

  const itemsData = (window as any).__SEARCH_DATA__ || [];

  function performSearch(query: string) {
    const q = query.trim().toLowerCase();
    
    if (clearBtn) {
      clearBtn.style.display = q ? 'inline-flex' : 'none';
    }

    const filtered = itemsData.filter((art: any) => {
      if (!q) return true;
      const inTitle = art.title.toLowerCase().includes(q);
      const inDesc = art.description.toLowerCase().includes(q);
      const inCat = art.category.toLowerCase().includes(q);
      const inTags = art.tags.some((t: string) => t.toLowerCase().includes(q));
      return inTitle || inDesc || inCat || inTags;
    });

    if (countEl) countEl.textContent = String(filtered.length);

    if (grid && noResults) {
      if (filtered.length === 0) {
        grid.style.display = 'none';
        noResults.style.display = 'block';
      } else {
        grid.style.display = 'grid';
        noResults.style.display = 'none';
        grid.innerHTML = filtered.map((art: any) => art.type === 'brand' ? `
          <article class="post-card search-brand-card">
            <a class="post-thumbnail" href="${art.url}" aria-label="阅读：${art.title}">
              <img src="${art.cover}" alt="${art.title}" width="1200" height="630" loading="lazy" decoding="async" />
            </a>
            <div class="post-card-content">
              <div class="post-card-header"><span class="post-category">机场独立评测</span><h3><a href="${art.url}">${art.title}</a></h3></div>
              <p>${art.description}</p>
              <div class="post-card-meta"><span>📅 ${art.formattedDate}</span><span>${art.readingTime}</span><span>作者：${art.author}</span><a class="post-read-more" href="${art.url}">查看评测 →</a></div>
            </div>
          </article>` : `
          <article class="post-card tone-${art.coverTone}">
            <a class="post-thumbnail" href="${art.url}" aria-label="阅读：${art.title}">
              <div class="post-thumbnail-fallback" aria-hidden="true"><span>${art.category}</span><strong>${art.title.slice(0, 1)}</strong></div>
            </a>
            <div class="post-card-content">
              <div class="post-card-header"><span class="post-category">${art.category}</span><h3><a href="${art.url}">${art.title}</a></h3></div>
              <p>${art.description}</p>
              <div class="post-card-meta"><span>📅 ${art.formattedDate}</span><span>◷ ${art.readingTime}</span><span>作者：${art.author}</span><a class="post-read-more" href="${art.url}">阅读全文 →</a></div>
            </div>
          </article>`).join('');
      }
    }
  }

  // Read URL query parameter on init
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q') || '';
  if (input) {
    input.value = initialQuery;
    performSearch(initialQuery);
    input.addEventListener('input', (e) => performSearch((e.target as HTMLInputElement).value));
  }

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      performSearch('');
      input.focus();
    }
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      if (input) {
        input.value = tag;
        performSearch(tag);
      }
    });
  });
</script>

<style>
  .page-container {
    padding-top: 2rem;
  }

  .search-section {
    margin-bottom: 2rem;
  }

  .search-input-container {
    position: relative;
    width: 100%;
    margin-bottom: 1rem;
  }

  .search-icon-inside {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-field {
    width: 100%;
    padding: 1.1rem 3rem 1.1rem 3.2rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    color: var(--text-primary);
    font-size: 1.1rem;
    outline: none;
    transition: all var(--transition-fast);
  }

  .search-field:focus {
    border-color: var(--tone-lime);
    box-shadow: 0 0 0 3px rgba(204, 255, 0, 0.15);
  }

  .clear-btn {
    position: absolute;
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 50%;
  }

  .clear-btn:hover {
    color: var(--text-primary);
    background: var(--bg-card);
  }

  .search-tags-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .search-tag-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tag-pill-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-pill-btn:hover {
    border-color: var(--tone-lime-border);
    color: var(--tone-lime);
  }

  .search-status {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-status span {
    color: var(--tone-lime);
    font-weight: 700;
  }

  .no-results-box {
    padding: 5rem 2rem;
    text-align: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }

  .no-results-box h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .no-results-box p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
