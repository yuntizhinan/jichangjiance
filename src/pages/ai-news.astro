---
import { getCollection } from 'astro:content';
import { ArrowRight, BrainCircuit, Grid3x3, Newspaper, ShieldCheck, Sparkles, Workflow } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { absoluteUrl } from '../lib/site';
import { aiApps, aiColumns, aiDailyItems } from '../data/aiContent';

const aiArticles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'AI资讯'))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const appCategories = [...new Set(aiApps.map((item) => item.category))];
const faqs = [
  { question: 'AI资讯页如何避免只做新闻搬运？', answer: '每条内容都拆分为发生了什么、影响谁、怎样验证和下一步做什么。没有明确使用价值的信息不会仅为了数量收录。' },
  { question: 'AI应用库为什么不直接做排行榜？', answer: '工具价值与任务、数据、团队和预算有关。应用库按场景和限制组织，避免用一个总分替代实际选型。' },
  { question: '快速变化的信息如何维护？', answer: '页面保留更新时间，产品能力、价格或可用范围发生变化时会调整结论，专题文章则保留更稳定的方法和判断框架。' }
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'AI资讯分享：每日新闻、AI应用库与专题专栏',
    description: '整理2026年AI模型、Agent、应用工具、内容风控和人才趋势，提供每日资讯、应用选择与专业实践文章。',
    url: absoluteUrl('/ai-news/'), dateModified: '2026-10-06', inLanguage: 'zh-CN',
    mainEntity: { '@type': 'ItemList', itemListElement: aiArticles.map((article, index) => ({ '@type': 'ListItem', position: index + 1, name: article.data.title, url: absoluteUrl(`/articles/${article.id}/`) })) }
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }
];
---

<BaseLayout
  title="AI资讯分享：每日AI新闻、应用库、Agent与专业专栏"
  description="更新2026每日AI资讯、AI应用工具库、AI Agent工作流、大模型内容风控、人才趋势和专业实践文章，帮助中文用户理解变化并转化为可执行方法。"
  keywords={['AI资讯分享', '每日AI新闻', 'AI应用库', 'AI工具推荐', 'AI Agent', '大模型内容风控', 'AI人才报告', '人工智能资讯']}
  jsonLd={jsonLd}
>
  <div class="shell ai-page">
    <Breadcrumbs items={[{ label: 'AI资讯分享' }]} />

    <header class="ai-hero">
      <div>
        <span><Sparkles size={15} /> AI INTELLIGENCE · UPDATED 2026-10-06</span>
        <h1>看懂AI变化，<br />再把它变成工作方法</h1>
        <p>这里不只记录模型和产品更新，而是继续追踪影响范围、落地条件、风险边界和可执行动作。内容覆盖每日资讯、AI应用库、Agent、内容生产、治理与人才能力。</p>
        <nav aria-label="AI资讯快速入口">
          <a href="/ai-news/daily/">每日AI资讯 <ArrowRight size={14} /></a>
          <a href="/ai-news/apps/">AI应用库 <ArrowRight size={14} /></a>
          <a href="/ai-news/columns/">专题专栏 <ArrowRight size={14} /></a>
        </nav>
      </div>
      <aside>
        <BrainCircuit size={34} />
        <strong>资讯 → 判断 → 实践</strong>
        <p>热点只负责告诉你发生了什么；真正有价值的是判断它会影响谁、需要改什么，以及哪些结论仍待验证。</p>
      </aside>
    </header>

    <section class="ai-stats" aria-label="AI内容概览">
      <article><Newspaper size={21} /><strong>{aiDailyItems.length}</strong><span>近期资讯观察</span></article>
      <article><Grid3x3 size={21} /><strong>{aiApps.length}</strong><span>AI应用条目</span></article>
      <article><Workflow size={21} /><strong>{aiColumns.length}</strong><span>专业专题方向</span></article>
      <article><ShieldCheck size={21} /><strong>{aiArticles.length}</strong><span>原创深度文章</span></article>
    </section>

    <section class="daily-preview">
      <div class="section-heading"><div><span>DAILY AI SIGNALS</span><h2>近期值得跟进的AI变化</h2><p>不追求罗列所有新闻，而是筛选会影响产品、团队、内容与职业能力的长期信号。</p></div><a href="/ai-news/daily/">查看完整日报 <ArrowRight size={15} /></a></div>
      <div class="daily-list">
        {aiDailyItems.slice(0, 3).map((item) => (
          <article>
            <div class="daily-meta"><time datetime={item.date}>{item.date}</time><span>{item.category}</span></div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <div><strong>建议：</strong>{item.action}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="app-preview">
      <div class="section-heading"><div><span>AI APP LIBRARY</span><h2>按任务选择AI应用</h2><p>从工作目标出发，比较适用场景、限制和团队协作成本。</p></div><a href="/ai-news/apps/">进入应用库 <ArrowRight size={15} /></a></div>
      <div class="app-category-grid">
        {appCategories.map((category) => {
          const examples = aiApps.filter((item) => item.category === category);
          return <a href={`/ai-news/apps/?category=${encodeURIComponent(category)}`}><Grid3x3 size={20} /><h3>{category}</h3><p>{examples.slice(0, 3).map((item) => item.name).join('、')}</p><span>{examples.length} 个工具条目</span></a>;
        })}
      </div>
    </section>

    <section class="column-preview">
      <div class="section-heading"><div><span>AI COLUMNS</span><h2>从热点进入长期专题</h2><p>将快速变化的新闻沉淀为可复用的工作框架、选型方法和治理清单。</p></div><a href="/ai-news/columns/">全部专题 <ArrowRight size={15} /></a></div>
      <div class="column-grid">
        {aiColumns.map((column, index) => (
          <a href={column.href}><span>{String(index + 1).padStart(2, '0')}</span><h3>{column.title}</h3><p>{column.description}</p><div>{column.tags.map((tag) => <small>{tag}</small>)}</div></a>
        ))}
      </div>
    </section>

    <section class="article-section">
      <div class="section-heading"><div><span>ORIGINAL ANALYSIS</span><h2>AI深度文章与实践指南</h2><p>文章围绕真实任务重新组织，不在正文堆放外部参考链接。</p></div><a href="/articles/">全部文章 <ArrowRight size={15} /></a></div>
      {aiArticles.length > 0 ? <div class="article-list">{aiArticles.map((article) => <ArticleCard article={article} />)}</div> : <p class="empty">AI专题文章正在整理。</p>}
    </section>

    <section class="ai-faq">
      <div class="section-heading"><div><span>FAQ</span><h2>AI资讯分享常见问题</h2></div></div>
      {faqs.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </section>
  </div>
</BaseLayout>

<style>
  .ai-page { padding-top: 1.5rem; padding-bottom: 2rem; }
  .ai-hero { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(270px, .55fr); gap: 1.3rem; padding: 2.3rem; color: #fff; background: linear-gradient(105deg, rgba(68,43,30,.84) 0%, rgba(121,77,48,.68) 52%, rgba(142,102,69,.32) 100%), url('/images/site-bg/warm/ai-coding-warm.webp') center 52% / cover no-repeat; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .ai-hero > div > span { display: inline-flex; align-items: center; gap: .4rem; color: #ffd6b2; font-size: .7rem; font-weight: 800; letter-spacing: .1em; }
  .ai-hero h1 { margin-top: .75rem; font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.12; letter-spacing: -.045em; }
  .ai-hero > div > p { max-width: 760px; margin-top: .8rem; color: rgba(255,255,255,.8); font-size: .91rem; line-height: 1.8; }
  .ai-hero nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.1rem; }
  .ai-hero nav a { display: inline-flex; align-items: center; gap: .3rem; padding: .4rem .7rem; border: 1px solid rgba(255,244,232,.3); border-radius: 999px; font-size: .72rem; }
  .ai-hero nav a:hover { color: #653e29; background: #fff3e7; }
  .ai-hero aside { display: flex; flex-direction: column; justify-content: flex-end; padding: 1.2rem; background: rgba(68,40,25,.25); border: 1px solid rgba(255,244,232,.22); border-radius: var(--radius-md); }
  .ai-hero aside svg { color: #ffd0a5; }.ai-hero aside strong { margin-top: .7rem; }.ai-hero aside p { margin-top: .35rem; color: rgba(255,248,241,.75); font-size: .75rem; line-height: 1.65; }
  .ai-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; margin-top: 1rem; }
  .ai-stats article { display: grid; grid-template-columns: auto 1fr; gap: .1rem .65rem; padding: .9rem 1rem; background: #fff; border: 1px solid #e7e9ed; box-shadow: var(--shadow-sm); }
  .ai-stats svg { grid-row: 1 / 3; align-self: center; color: #8d718e; }.ai-stats strong { font-size: 1.3rem; line-height: 1.2; }.ai-stats span { color: var(--text-muted); font-size: .68rem; }
  .daily-preview, .app-preview, .column-preview, .article-section, .ai-faq { margin-top: 2.6rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading > div > span { color: #8d718e; font-size: .66rem; font-weight: 800; letter-spacing: .12em; }.section-heading h2 { margin-top: .2rem; font-size: 1.45rem; }.section-heading p { max-width: 700px; margin-top: .25rem; color: var(--text-secondary); font-size: .79rem; }
  .section-heading > a { display: inline-flex; align-items: center; gap: .3rem; flex: 0 0 auto; color: #8d718e; font-size: .73rem; font-weight: 700; }
  .daily-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .daily-list article { padding: 1rem; background: #fffdf9; border: 1px solid var(--border-color); border-top: 3px solid #8d718e; border-radius: var(--radius-md); }
  .daily-meta { display: flex; align-items: center; justify-content: space-between; gap: .5rem; color: var(--text-muted); font-size: .65rem; }.daily-meta span { padding: .15rem .38rem; color: #8d718e; background: #f6f0f5; }
  .daily-list h3 { margin-top: .65rem; font-size: .9rem; line-height: 1.5; }.daily-list > article > p { margin-top: .35rem; color: var(--text-secondary); font-size: .72rem; line-height: 1.65; }.daily-list article > div:last-child { margin-top: .7rem; padding-top: .6rem; color: #65717d; border-top: 1px dashed #dfe3e7; font-size: .68rem; line-height: 1.55; }
  .app-category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .app-category-grid a { padding: 1rem; background: #fffdf9; border: 1px solid var(--border-color); border-radius: var(--radius-md); transition: .2s ease; }.app-category-grid a:hover { transform: translateY(-2px); border-color: #cdb8cb; }.app-category-grid svg { color: #8d718e; }.app-category-grid h3 { margin-top: .6rem; font-size: .9rem; }.app-category-grid p { margin-top: .25rem; color: var(--text-secondary); font-size: .72rem; }.app-category-grid span { display: block; margin-top: .55rem; color: #8d718e; font-size: .66rem; }
  .column-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }.column-grid > a { min-width: 0; padding: 1rem; background: #fff; border: 1px solid #e5e8ec; }.column-grid > a > span { color: #c8bde3; font-size: 1.2rem; font-weight: 800; }.column-grid h3 { margin-top: .25rem; font-size: .9rem; }.column-grid p { min-height: 3.2rem; margin-top: .3rem; color: var(--text-secondary); font-size: .71rem; line-height: 1.6; }.column-grid div { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .55rem; }.column-grid small { padding: .12rem .35rem; color: #7759b8; background: #f2effa; font-size: .6rem; }
  .article-list { display: grid; gap: 1rem; }.empty { padding: 1rem; color: var(--text-muted); background: #fff; border: 1px solid #e5e8ec; }
  .ai-faq details { padding: .85rem 0; border-top: 1px solid #dde1e5; }.ai-faq summary { cursor: pointer; color: #414b56; font-size: .84rem; font-weight: 700; }.ai-faq details p { max-width: 800px; margin-top: .5rem; color: var(--text-secondary); font-size: .76rem; line-height: 1.7; }
  @media (max-width: 900px) { .ai-hero { grid-template-columns: 1fr; }.ai-stats, .daily-list { grid-template-columns: repeat(2, 1fr); }.app-category-grid, .column-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .ai-hero { padding: 1.3rem 1rem; }.ai-hero h1 { font-size: 1.85rem; }.ai-stats, .daily-list, .app-category-grid, .column-grid { grid-template-columns: 1fr; }.section-heading { align-items: flex-start; flex-direction: column; }.column-grid p { min-height: 0; } }
</style>
