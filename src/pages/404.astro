---
import BaseLayout from '../layouts/BaseLayout.astro';
import { House, ArrowLeft } from '@lucide/astro';
---

<BaseLayout
  title="页面未找到 - 404"
  description="抱歉，您访问的页面不存在或已被移除。"
  robots="noindex, follow"
>
  <div class="shell error-container">
    <div class="error-box">
      <div class="error-code">404</div>
      <h1>页面未找到</h1>
      <p>抱歉，您请求的页面不存在、已被移除或 URL 拼写有误。</p>
      <div class="error-actions">
        <a href="/" class="btn-home"><House size={16} /> 返回首页</a>
        <a href="/articles/" class="btn-articles"><ArrowLeft size={16} /> 浏览文章库</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    padding: 6rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .error-box {
    text-align: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 4rem 3rem;
    max-width: 36rem;
    width: 100%;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    color: var(--tone-lime);
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
  }

  .error-box h1 {
    font-size: 1.85rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .error-box p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    background: var(--tone-lime);
    color: #0a0d14;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .btn-articles {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 0.9rem;
  }
</style>
