---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return categories.map((cat) => {
    const catArticles = articles
      .filter((a) => a.data.category === cat.name)
      .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
    return {
      params: { slug: cat.slug },
      props: { category: cat, articles: catArticles }
    };
  });
}

const { category, articles } = Astro.props;
---

<BaseLayout
  title={`${category.name}专栏`}
  description={category.description}
>
  <div class="shell page-container">
    <Breadcrumbs
      items={[
        { label: '主题导航', href: '/categories/' },
        { label: `${category.name}专栏` }
      ]}
    />

    <div class="page-hero">
      <span class="cat-badge-pill">{category.name}</span>
      <h1>{category.name}指南与文章</h1>
      <p>{category.description}</p>
    </div>

    <div class="blog-main category-main">
      <main>
        {articles.length > 0 ? (
          <div class="articles-grid">{articles.map((article: any) => <ArticleCard article={article} />)}</div>
        ) : (
          <div class="empty-box"><p>该分类下暂无文章，请稍后再试。</p></div>
        )}
      </main>
      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2rem;
  }

  .cat-badge-pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--tone-lime-bg);
    color: var(--tone-lime);
    border: 1px solid var(--tone-lime-border);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .category-main { padding-top: 0; }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-muted);
  }
</style>
